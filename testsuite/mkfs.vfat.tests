#!/bin/sh
# mkfs.vfat tests.
# Copyright 2026 by Denys Vlasenko
# Licensed under GPLv2, see file LICENSE in this source tree.

. ./testing.sh

# testing "test name" "options" "expected result" "file input" "stdin"

optional BLKID
# This creates 32MB FAT32 image, and tests that blkid does recognize it.
# This is technically incorrect: at this size, image should be FAT16
# according to Microsoft rules (it says that FAT12/16/32-ness of the volume
# is _solely_ determined by cluster count).
# But Linux kernel happily mounts these small FAT32 images.
testing "mkfs.vfat 32MB image" \
	"dd if=/dev/zero of=input bs=512 count=65536 2>/dev/null; mkfs.vfat input 2>&1 && blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/' " \
'input: UUID="xxxx-xxxx" TYPE="vfat"
' \
	"" ""

# The minimal image with default -b6 -R32 (has just 2 FAT sectors and 2 data sectors)
testing "mkfs.vfat 18KB image" \
	"mkfs.vfat input 18 2>&1 && blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/' " \
'input: UUID="xxxx-xxxx" TYPE="vfat"
' \
	"" ""

# The minimal image which can still be mounted and can have non-zero-length files
testing "mkfs.vfat -b0 -R2 3KB image" \
	"mkfs.vfat -b0 -R2 input 3 2>&1 && blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/' " \
'input: UUID="xxxx-xxxx" TYPE="vfat"
' \
	"" ""

# Create maximal possible one-sector-per-cluster FAT32:
# FATs should have precisely 2097152 sectors: this holds enough entries for 2097152*512/4 = 0x10000000 clusters.
# Actual number of clusters should be 268435445 = 0x0ffffff5 (the maximum cluster# is 0x0ffffff6).
testing "mkfs.vfat -bo -R3 -s1 136314876 kbyte (130GB) image" \
	"rm input \\
	&& mkfs.vfat -v -F32 -b0 -R3 -s1 -C input 136314876 2>&1 | grep -eclusters:268435445 -esectors/FAT:2097152 \\
	&& blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/'
	" \
'total sectors:272629752, clusters:268435445, sectors/cluster:1
FATs:2, sectors/FAT:2097152
input: UUID="xxxx-xxxx" TYPE="vfat"
' \
	"" ""

exit $FAILCOUNT
